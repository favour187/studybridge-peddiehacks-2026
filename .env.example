# Required for real AI
GROQ_API_KEY=gsk_replace_with_your_key
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Required for persistent school data (Render PostgreSQL, Supabase, or Neon)
DATABASE_URL=postgresql://user:password@host:5432/database
DATABASE_SSL=true

# Required for real authentication. Generate a long random value.
JWT_SECRET=replace_with_at_least_32_random_characters

# Optional SMS via Termii
TERMII_API_KEY=
TERMII_SENDER_ID=Lighthouse
TERMII_CHANNEL=generic
TERMII_API_URL=https://v3.api.termii.com/api/sms/send

# Optional WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0

# Optional demo configuration
DEMO_ADMIN_PIN=2026
DEMO_TEACHER_PIN=2468
DEMO_STUDENT_PIN=1357
DEMO_PARENT_PIN=8642
DEMO_SAFEGUARD_PIN=9753
DEMO_PARENT_PHONE=

NODE_ENV=production
